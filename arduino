
#include <Wire.h>


int relay1 = D4;//left
int relay2 = D5;//right
int relay3 = D6;//middle


// Define the size of the Gaussian kernel (must be odd)
#define KERNEL_SIZE 5
#define HALF_KERNEL (KERNEL_SIZE / 2)

// Pre-computed Gaussian kernel coefficients for a 5-point kernel.
// These values approximate a Gaussian distribution and already sum to ~1.0.
float gaussianKernel[KERNEL_SIZE] = {0.06136, 0.24477, 0.38774, 0.24477, 0.06136};


float RateRoll, RatePitch, RateYaw;
float RateCalibrationRoll, RateCalibrationPitch, RateCalibrationYaw;
int RateCalibrationNumber;
float AccX, AccY, AccZ;
float AngleRoll, AnglePitch;
uint32_t LoopTimer;
float KalmanAngleRoll = 0, KalmanUncertaintyAngleRoll = 2 * 2;
float KalmanAnglePitch = 0, KalmanUncertaintyAnglePitch = 2 * 2;
float Kalman1DOutput[] = { 0, 0 };


float AverageRoll = 0;
float AveragePitch = 0;
int ValveCalibrationAllowance = 5;
int CalibrationStartAllowance = 10;


// A function that accepts arrays of any type T and any length N, 
// and returns the length N. 
