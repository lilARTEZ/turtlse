int AppendToArray(float *arrayPointer, int arraySize, float newValue) {
  arrayPointer = arrayPointer + arraySize;
  *arrayPointer = newValue;
  return arraySize+1;
}




void kalman_1d(float KalmanState, float KalmanUncertainty, float KalmanInput, float KalmanMeasurement) {
  KalmanState = KalmanState + 0.004 * KalmanInput;
  KalmanUncertainty = KalmanUncertainty + 0.004 * 0.004 * 4 * 4;
  float KalmanGain = KalmanUncertainty * 1 / (1 * KalmanUncertainty + 3 * 3);
  KalmanState = KalmanState + KalmanGain * (KalmanMeasurement - KalmanState);
  KalmanUncertainty = (1 - KalmanGain) * KalmanUncertainty;
  Kalman1DOutput[0] = KalmanState;
  Kalman1DOutput[1] = KalmanUncertainty;
}


void gyro_signals(void) {
  Wire.beginTransmission(0x68);
  Wire.write(0x1A);
  Wire.write(0x05);
  Wire.endTransmission();
  Wire.beginTransmission(0x68);
  Wire.write(0x1C);
  Wire.write(0x10);
  Wire.endTransmission();
  Wire.beginTransmission(0x68);
  Wire.write(0x3B);
  Wire.endTransmission();
  Wire.requestFrom(0x68, 6);
  int16_t AccXLSB = Wire.read() << 8 | Wire.read();
  int16_t AccYLSB = Wire.read() << 8 | Wire.read();
  int16_t AccZLSB = Wire.read() << 8 | Wire.read();
  Wire.beginTransmission(0x68);
  Wire.write(0x1B);
  Wire.write(0x8);
  Wire.endTransmission();
  Wire.beginTransmission(0x68);
  Wire.write(0x43);
  Wire.endTransmission();
  Wire.requestFrom(0x68, 6);
  int16_t GyroX = Wire.read() << 8 | Wire.read();
  int16_t GyroY = Wire.read() << 8 | Wire.read();
  int16_t GyroZ = Wire.read() << 8 | Wire.read();
  RateRoll = (float)GyroX / 65.5;
  RatePitch = (float)GyroY / 65.5;
  RateYaw = (float)GyroZ / 65.5;
  AccX = (float)AccXLSB / 4096;
  AccY = (float)AccYLSB / 4096;
  AccZ = (float)AccZLSB / 4096;
  AngleRoll = atan(AccY / sqrt(AccX * AccX + AccZ * AccZ)) * 1 / (3.142 / 180);
  AnglePitch = -atan(AccX / sqrt(AccY * AccY + AccZ * AccZ)) * 1 / (3.142 / 180);
}



void angles() {
  gyro_signals();
  RateRoll -= RateCalibrationRoll;
  RatePitch -= RateCalibrationPitch;
  RateYaw -= RateCalibrationYaw;
  kalman_1d(KalmanAngleRoll, KalmanUncertaintyAngleRoll, RateRoll, AngleRoll);
  KalmanAngleRoll = Kalman1DOutput[0];
  KalmanUncertaintyAngleRoll = Kalman1DOutput[1];
  kalman_1d(KalmanAnglePitch, KalmanUncertaintyAnglePitch, RatePitch, AnglePitch);
  KalmanAnglePitch = Kalman1DOutput[0];
  KalmanUncertaintyAnglePitch = Kalman1DOutput[1];
  //Serial.print("Roll Angle [°] ");
  //Serial.print(KalmanAngleRoll);
  //Serial.print(" Pitch Angle [°] ");
  //Serial.println(KalmanAnglePitch);
  while (micros() - LoopTimer < 4000);
  LoopTimer = micros();
}


// Function to smooth an array of data using Gaussian smoothing.
// 'input' is your original data array, 'output' will contain the smoothed data,
// and 'dataSize' is the number of elements in your data array.
void gaussianSmooth(const float* input, float* output, int dataSize) {
  // Loop over each data point in the input array.
  for (int i = 0; i < dataSize; i++) {
    float sum = 0.0;
    float weightSum = 0.0;

    // Apply the kernel centered at position i.
    for (int j = -HALF_KERNEL; j <= HALF_KERNEL; j++) {
      int index = i + j;
      // Make sure we don't access out-of-bound array indices.
      if (index >= 0 && index < dataSize) {
        float weight = gaussianKernel[j + HALF_KERNEL];
        sum += input[index] * weight;
        weightSum += weight;
      }
    }
    // Assign the normalized smoothed value to the output.
    output[i] = sum / weightSum;
  }
}




void setup() {
  Serial.begin(57600);

  pinMode(relay1, OUTPUT);
  pinMode(relay2, OUTPUT);
  digitalWrite(relay1, HIGH);
  digitalWrite(relay2, HIGH);

  Wire.setClock(400000);
  Wire.begin();
  delay(250);
  Wire.beginTransmission(0x68);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();


  for (RateCalibrationNumber = 0; RateCalibrationNumber < 2000; RateCalibrationNumber++) {
    gyro_signals();
    RateCalibrationRoll += RateRoll;
    RateCalibrationPitch += RatePitch;
    RateCalibrationYaw += RateYaw;
    delay(1);
  }

  RateCalibrationRoll /= 2000;
  RateCalibrationPitch /= 2000;
  RateCalibrationYaw /= 2000;
  LoopTimer = micros();

  Serial.println(" ");


  int probingSize=500, probingTime=5000;
  int calibratingSteps=1000, calibratingTime=2000;
  float rollSum=0,pitchSum=0;

  for(int i=0;i<calibratingSteps;i++){
    angles();
    delay(calibratingTime/calibratingSteps);
  }

  int iter=1;
  while (iter <= probingSize) {
    delay(probingTime/probingSize);
    Serial.print(iter);
    Serial.print(" ");
    angles();
    rollSum=rollSum+KalmanAngleRoll;
    pitchSum=pitchSum+KalmanAnglePitch;
    iter++;
  }

  AverageRoll = rollSum/probingSize;
  Serial.print("average roll ");
  Serial.println(AverageRoll);
  AveragePitch = pitchSum/probingSize;
  Serial.print("average pitch ");
  Serial.println(AveragePitch);
}



void relevelSingleValve(int valvePin,int angleType){
  // angleType - 0-roll 1-pitch
  digitalWrite(valvePin, LOW);
  while(true){
    int probingTime = 6, probingSize = 5;
    float probingData[5];
    float gaussSmoothedData[5];
    float gaussSum=0;
    float gaussAvg=0;

    int iter=1;

    while (iter <= probingSize) {
      angles();

      if(angleType>0){
        probingData[iter-1]=KalmanAngleRoll;
      }else{
        probingData[iter-1]=KalmanAnglePitch;
      }

      delay(probingTime/probingSize);
      iter++;
    }

    gaussianSmooth(probingData,gaussSmoothedData,probingSize);

    for(int i =0;i<probingSize;i++){
      gaussSum=gaussSum+gaussSmoothedData[i];
    }

    gaussAvg=gaussSum/probingSize;////no work ):

    if(gaussAvg<ValveCalibrationAllowance && valvePin==relay2){
      Serial.print("gaussAvg");
      Serial.println(gaussAvg);
      break;
    }else if(gaussAvg>-ValveCalibrationAllowance && valvePin==relay1){
      Serial.print("gaussAvg");
      Serial.println(gaussAvg);
      break;
    }
  }
  digitalWrite(valvePin, HIGH);
}





int iteration=1;
float CorrectionRollSum=0;
float CorrectionAngleSum=0;
void loop() {


  int probingTime = 100, probingSize = 50;

  angles();
  float CorrectionRoll=KalmanAngleRoll-AverageRoll;
  float CorrectionAngle=KalmanAnglePitch-AveragePitch;


  //Serial.print("CorrectionRoll ");
  //Serial.println(CorrectionRoll);
  //Serial.print("CorrectionAnglell ");
  //Serial.println(CorrectionAngle);

  CorrectionRollSum=CorrectionRollSum+CorrectionRoll;
  CorrectionAngleSum=CorrectionAngleSum+CorrectionAngle;



  if(iteration>=probingSize){
    float CorrectionRollAverage=CorrectionRollSum/probingSize;
    float CorrectionAngleAverage=CorrectionAngleSum/probingSize;
    Serial.print("CorrectionRollAverage ");
    Serial.println(CorrectionRollAverage);
    //Serial.print("CorrectionAngleAverage ");
    //Serial.println(CorrectionAngleAverage);

    CorrectionRollSum=0;
    CorrectionAngleSum=0;
    iteration=0;



    if(CorrectionRollAverage>CalibrationStartAllowance){

      relevelSingleValve(relay1,0);

    }else if(CorrectionRollAverage<-CalibrationStartAllowance){

      relevelSingleValve(relay2,0);

    }else{
      digitalWrite(relay1, HIGH);
      digitalWrite(relay2, HIGH);
    }



  }
  


  delay(probingTime/probingSize);
  iteration++;
}
